<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:og="http://schemas.neoorder.org/onegate/controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="NeoOrder.OneGate.Pages.ChatSettingsPage"
             Title="{x:Static og:Strings.ChatSettings}"
             SafeAreaEdges="All"
             BindingContext="{Binding Source={RelativeSource Self}}"
             Shell.TabBarIsVisible="False">
    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrWhiteSpaceConverter x:Key="HasText" />
        <toolkit:InvertedBoolConverter x:Key="Not" />
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="16" MaximumWidthRequest="520" HorizontalOptions="Fill">
            <Grid WidthRequest="100" HeightRequest="100" HorizontalOptions="Center"
                  IsVisible="{Binding HasSettings}" IsEnabled="{Binding CanEditAvatar}">
                <og:ChatAvatarView IsSelf="True" DisplayName="{Binding Nickname}" WidthRequest="88" HeightRequest="88" StrokeShape="RoundRectangle 24"
                                   HorizontalOptions="Start" VerticalOptions="Start">
                    <og:ChatAvatarView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEditAvatarClicked" />
                    </og:ChatAvatarView.GestureRecognizers>
                </og:ChatAvatarView>
                <Grid WidthRequest="44" HeightRequest="44" HorizontalOptions="End" VerticalOptions="End">
                    <Border WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="2"
                            HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True"
                            BackgroundColor="{toolkit:AppThemeResource Panel}" Stroke="{toolkit:AppThemeResource PageBackground}" />
                    <Button Text="&#xe63d;" StyleClass="Icon, Link" FontSize="16" WidthRequest="44" HeightRequest="44"
                            SemanticProperties.Description="{x:Static og:Strings.ChatAvatarChange}"
                            ToolTipProperties.Text="{x:Static og:Strings.ChatAvatarChange}" Clicked="OnEditAvatarClicked" />
                </Grid>
            </Grid>
            <Grid ColumnDefinitions="*,44" ColumnSpacing="8" IsVisible="{Binding Address, Converter={StaticResource HasText}}">
                <Label Text="{Binding Address}" StyleClass="Secondary" LineBreakMode="CharacterWrap" VerticalTextAlignment="Center" />
                <Button Grid.Column="1" StyleClass="Icon, IconSecondary" Text="&#xe664;" FontSize="18"
                        WidthRequest="44" HeightRequest="44" VerticalOptions="Center"
                        SemanticProperties.Description="{x:Static og:Strings.CopyAddress}"
                        ToolTipProperties.Text="{x:Static og:Strings.CopyAddress}"
                        Command="{x:Static og:Commands.Copy}" CommandParameter="{Binding Address}" />
            </Grid>
            <Grid ColumnDefinitions="*,44" ColumnSpacing="12" IsVisible="{Binding HasSettings}">
                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="{x:Static og:Strings.ChatNickname}" StyleClass="Secondary" FontSize="12" />
                    <Label Text="{Binding Nickname, TargetNullValue='—'}" LineBreakMode="CharacterWrap" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="&#xe63d;" StyleClass="Icon, Link" FontSize="22" Padding="0"
                        MinimumHeightRequest="44" IsEnabled="{Binding CanEdit}" Clicked="OnEditNicknameClicked"
                        SemanticProperties.Description="{x:Static og:Strings.ChatNickname}" />
            </Grid>
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasSettings}">
                <Grid ColumnDefinitions="*,44" ColumnSpacing="12" IsVisible="{Binding IsEditingBio, Converter={StaticResource Not}}">
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="{x:Static og:Strings.ChatBio}" StyleClass="Secondary" FontSize="12" />
                        <Label Text="{Binding Bio, TargetNullValue='—'}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="&#xe63d;" StyleClass="Icon, Link" FontSize="22" Padding="0"
                            MinimumHeightRequest="44" IsEnabled="{Binding CanEdit}" Clicked="OnEditBioClicked"
                            SemanticProperties.Description="{x:Static og:Strings.ChatBio}" />
                </Grid>
                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsEditingBio}">
                    <Label Text="{x:Static og:Strings.ChatBio}" StyleClass="Secondary" FontSize="12" />
                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="{toolkit:AppThemeResource TextBox}" Padding="10,5">
                        <Editor Text="{Binding BioDraft, Mode=TwoWay}" AutoSize="TextChanges" MinimumHeightRequest="96"
                                IsReadOnly="{Binding CanEdit, Converter={StaticResource Not}}" og:Border.IsVisible="False"
                                SemanticProperties.Description="{x:Static og:Strings.ChatBio}" />
                    </Border>
                    <Label Text="{x:Static og:Strings.ChatBioHint}" StyleClass="Secondary" FontSize="12" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsEnabled="{Binding CanEdit}">
                        <Button Text="{x:Static og:Strings.Cancel}" StyleClass="Secondary" Clicked="OnCancelBioClicked" />
                        <Button Grid.Column="1" Text="{x:Static og:Strings.ChatSaveBio}" Clicked="OnSaveBioClicked" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,auto" ColumnSpacing="12" MinimumHeightRequest="44">
                <Label Text="{x:Static og:Strings.ChatAllowAddressDiscovery}" VerticalTextAlignment="Center" LineBreakMode="WordWrap" />
                <Switch Grid.Column="1" IsToggled="{Binding AllowAddressDiscovery, Mode=OneWay}" IsEnabled="{Binding CanEdit}"
                        Toggled="OnDiscoveryToggled" SemanticProperties.Description="{x:Static og:Strings.ChatAllowAddressDiscovery}" />
            </Grid>
            <Label Text="{Binding DiscoveryHint}" StyleClass="Secondary" IsVisible="{Binding HasSettings}" />
            <HorizontalStackLayout Spacing="10" IsVisible="{Binding ShowLoading}" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding ShowLoading}" WidthRequest="20" HeightRequest="20" />
                <Label Text="{Binding BusyText}" StyleClass="Secondary" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
            <Label Text="{Binding ErrorText}" StyleClass="Danger" IsVisible="{Binding ErrorText, Converter={StaticResource HasText}}" />
            <Button Text="{x:Static og:Strings.Retry}" IsVisible="{Binding CanRetry}" Clicked="OnRetryClicked" />
            <Button Text="{x:Static og:Strings.ChatMyInvitation}" StyleClass="Secondary" IsVisible="{Binding HasSettings}" IsEnabled="{Binding CanEdit}"
                    Command="{x:Static og:Commands.GotoPage}" CommandParameter="//home/chat-invitation" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
