<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:og="http://schemas.neoorder.org/onegate/controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="NeoOrder.OneGate.Pages.ContactDetailsPage"
             Title="{x:Static og:Strings.ContactDetails}"
             SafeAreaEdges="All"
             BindingContext="{Binding Source={RelativeSource Self}}"
             Shell.TabBarIsVisible="False">
    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
        <toolkit:IsStringNotNullOrWhiteSpaceConverter x:Key="HasText" />
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static og:Strings.EditContact}" Order="Secondary"
                     Command="{Binding EditContactCommand}" />
        <ToolbarItem Text="{x:Static og:Strings.ChatRemoveContact}" Order="Secondary"
                     Command="{Binding RemoveChatContactCommand}" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="auto,*">
        <VerticalStackLayout Spacing="8" Padding="20,16,20,0" MaximumWidthRequest="600" HorizontalOptions="Fill"
                             IsVisible="{Binding ErrorText, Converter={StaticResource HasText}}">
            <Label Text="{Binding ErrorText}" StyleClass="Danger" LineBreakMode="WordWrap" />
            <Button Text="{x:Static og:Strings.Retry}" StyleClass="Link" HorizontalOptions="Start"
                    IsEnabled="{Binding LoadingService.IsLoading, Converter={StaticResource InvertedBoolConverter}}" Clicked="OnRetryClicked" />
        </VerticalStackLayout>
        <RefreshView Grid.Row="1" IsRefreshing="{Binding LoadingService.IsReloading}" Command="{Binding LoadingService}">
            <ScrollView>
                <Grid Padding="20,24" MaximumWidthRequest="600" HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="24" IsVisible="{Binding Contact, Converter={StaticResource IsNotNullConverter}}">
                        <VerticalStackLayout Spacing="12">
                            <og:ChatAvatarView StrokeShape="RoundRectangle 20" WidthRequest="72" HeightRequest="72" BackgroundColor="{toolkit:AppThemeResource BrandMuted}" HorizontalOptions="Center" BindingContext="{Binding Contact}" Address="{Binding Address}" DisplayName="{Binding DisplayName}" />
                            <Label Text="{Binding Contact.DisplayName, TargetNullValue={x:Static og:Strings.ChatNoNickname}}" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" LineBreakMode="CharacterWrap" />
                            <Label Text="{Binding Contact.ChatStatus, TargetNullValue={x:Static og:Strings.HomeAddressOnly}}" IsVisible="{Binding IsChatEnabled}" StyleClass="Secondary" FontSize="13" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <Border StyleClass="Card">
                            <Grid ColumnDefinitions="*,44" RowDefinitions="auto,auto" ColumnSpacing="8" RowSpacing="8">
                                <Label Grid.ColumnSpan="2" Text="{x:Static og:Strings.Address}" StyleClass="Secondary" FontSize="12" />
                                <Label Grid.Row="1" Text="{Binding Contact.Address}" FontSize="16" LineBreakMode="CharacterWrap" VerticalTextAlignment="Center" />
                                <Button Grid.Row="1" Grid.Column="1" StyleClass="Icon, IconSecondary" Text="&#xe664;" FontSize="18"
                                        WidthRequest="44" HeightRequest="44" VerticalOptions="Center"
                                        SemanticProperties.Description="{x:Static og:Strings.CopyAddress}"
                                        Command="{x:Static og:Commands.Copy}" CommandParameter="{Binding Contact.Address}" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding ProfileNickname, Converter={StaticResource HasText}}">
                            <Label Text="{x:Static og:Strings.ChatNickname}" StyleClass="Secondary" FontSize="12" />
                            <Label Text="{Binding ProfileNickname}" LineBreakMode="CharacterWrap" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding ProfileBio, Converter={StaticResource HasText}}">
                            <Label Text="{x:Static og:Strings.ChatBio}" StyleClass="Secondary" FontSize="12" />
                            <Label Text="{Binding ProfileBio}" LineBreakMode="CharacterWrap" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding Contact.Note, Converter={StaticResource HasText}}">
                            <Label Text="{x:Static og:Strings.Note}" StyleClass="Secondary" FontSize="12" />
                            <Label Text="{Binding Contact.Note}" LineBreakMode="CharacterWrap" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="12" IsEnabled="{Binding CanNavigate}">
                            <Grid IsVisible="{Binding IsChatEnabled}">
                                <Button Text="{x:Static og:Strings.ChatOpen}" IsVisible="{Binding Contact.CanChat}" Clicked="OnChatClicked" />
                                <Button Text="{Binding Contact.ChatRequestText}" IsVisible="{Binding Contact.CanChat, Converter={StaticResource InvertedBoolConverter}}" Clicked="OnChatClicked" />
                            </Grid>
                            <Button Text="{x:Static og:Strings.Transfer}" Clicked="OnTransferClicked" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </RefreshView>
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding ShowLoading}" IsVisible="{Binding ShowLoading}" VerticalOptions="Start" Margin="0,8" InputTransparent="True" />
    </Grid>
</ContentPage>
