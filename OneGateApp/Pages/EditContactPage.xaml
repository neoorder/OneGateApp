<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:og="http://schemas.neoorder.org/onegate/controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="NeoOrder.OneGate.Pages.EditContactPage"
             Title="{x:Static og:Strings.EditContact}"
             SafeAreaEdges="All"
             BindingContext="{Binding Source={RelativeSource Self}}"
             Shell.TabBarIsVisible="False">
    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="Not" />
        <toolkit:IsStringNotNullOrWhiteSpaceConverter x:Key="HasText" />
    </ContentPage.Resources>
    <Grid RowDefinitions="*,auto,auto" Margin="20" RowSpacing="12">
        <ScrollView IsEnabled="{Binding CanEdit}">
            <VerticalStackLayout Spacing="20">
            <Label StyleClass="Secondary" Text="{x:Static og:Strings.Address}" />
            <Border StrokeShape="RoundRectangle 5" Margin="0,-16,0,0">
                <ContentView Padding="10,5" BackgroundColor="{toolkit:AppThemeResource TextBox}">
                    <Entry Text="{Binding Contact.Address}" IsReadOnly="True" og:Border.IsVisible="False" />
                </ContentView>
            </Border>
            <Label StyleClass="Secondary" Text="{x:Static og:Strings.Label}" />
            <Border StrokeShape="RoundRectangle 5" Margin="0,-16,0,0">
                <ContentView Padding="10,5" BackgroundColor="{toolkit:AppThemeResource TextBox}">
                    <Entry x:Name="entryLabel" Text="{Binding Contact.Label}" og:Border.IsVisible="False" />
                </ContentView>
            </Border>
            <og:ValidationMessage Title="{x:Static og:Strings.Label}" Margin="0,-16,0,0" Target="{x:Reference entryLabel}">
                <og:Custom Validate="OnValidateLabelDuplicity" />
            </og:ValidationMessage>
            <Label StyleClass="Secondary" Text="{x:Static og:Strings.Note}" />
            <Border StrokeShape="RoundRectangle 5" Margin="0,-16,0,0">
                <ContentView Padding="10,5" BackgroundColor="{toolkit:AppThemeResource TextBox}">
                    <Editor Text="{Binding Contact.Note}" AutoSize="TextChanges" HeightRequest="80" og:Border.IsVisible="False" />
                </ContentView>
            </Border>
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsWorking}" IsVisible="{Binding IsWorking}" HeightRequest="24" />
            <Label Text="{Binding ErrorText}" StyleClass="Danger" IsVisible="{Binding ErrorText, Converter={StaticResource HasText}}" />
        </VerticalStackLayout>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="20" IsEnabled="{Binding CanEdit}">
            <Button StyleClass="Danger" Text="{x:Static og:Strings.Delete}" Clicked="OnDelete"
                    IsVisible="{Binding IsNewContact, Converter={StaticResource Not}}" />
            <og:Submit Grid.Column="1" Text="{x:Static og:Strings.OK}" Submitted="OnSubmitted">
                <og:Submit.Triggers>
                    <DataTrigger TargetType="og:Submit" Binding="{Binding IsNewContact}" Value="True">
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Grid.ColumnSpan" Value="2" />
                    </DataTrigger>
                </og:Submit.Triggers>
            </og:Submit>
        </Grid>
    </Grid>
</ContentPage>
