<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:og="http://schemas.neoorder.org/onegate/controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="NeoOrder.OneGate.Pages.HiddenAssetsPage"
             Title="{x:Static og:Strings.HiddenAssets}"
             BindingContext="{Binding Source={RelativeSource Self}}"
             Shell.TabBarIsVisible="False">
    <CollectionView Margin="20,16,20,20" ItemsSource="{Binding HiddenAssets}">
        <CollectionView.EmptyView>
            <Grid>
                <VerticalStackLayout Spacing="12" MaximumWidthRequest="320" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border StrokeShape="Ellipse" BackgroundColor="{toolkit:AppThemeResource TextBox}" WidthRequest="96" HeightRequest="96" HorizontalOptions="Center">
                        <Image Source="empty.png" WidthRequest="32" HeightRequest="32" Opacity="0.75" AutomationProperties.IsInAccessibleTree="False" />
                    </Border>
                    <Label Text="{x:Static og:Strings.NoHiddenAssets}" FontAttributes="Bold" FontSize="22" HorizontalTextAlignment="Center" />
                    <Label StyleClass="Secondary" Text="{x:Static og:Strings.NoHiddenAssetsText}" FontSize="13" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Grid>
        </CollectionView.EmptyView>
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="og:ITokenInfo">
                <Border StyleClass="Card" Padding="14">
                    <Grid ColumnDefinitions="auto,*,auto" ColumnSpacing="12">
                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="{toolkit:AppThemeResource TextBox}" WidthRequest="48" HeightRequest="48" Padding="8" VerticalOptions="Center">
                            <Image Source="{Binding Icon, TargetNullValue=tokens_icon_default.png}" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" AutomationProperties.IsInAccessibleTree="False" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding Symbol}" FontAttributes="Bold" FontSize="16" LineBreakMode="TailTruncation" />
                            <Label StyleClass="Secondary" Text="{Binding Name}" FontSize="12" LineBreakMode="TailTruncation" MaxLines="1" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" StyleClass="Link" Text="{x:Static og:Strings.Unhide}" BackgroundColor="{toolkit:AppThemeResource TextBox}" FontAttributes="Bold" FontSize="13" CornerRadius="22" Padding="14,8" MinimumWidthRequest="44" MinimumHeightRequest="44" VerticalOptions="Center" Clicked="OnUnhideClicked" CommandParameter="{Binding .}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>