<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
        x:Class="NeoOrder.OneGate.Controls.Views.ChatAvatarView"
        StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="0"
        WidthRequest="44" HeightRequest="44" BackgroundColor="{toolkit:AppThemeResource BrandMuted}">
    <Grid>
        <Image x:Name="DefaultIcon" StyleClass="DefaultAvatar" InputTransparent="True" />
        <Label x:Name="Initial" FontSize="18" FontAttributes="Bold" TextColor="{toolkit:AppThemeResource Brand}"
               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" InputTransparent="True" />
    </Grid>
</Border>
