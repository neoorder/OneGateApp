<?xml version="1.0" encoding="utf-8" ?>
<og:MyPopup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:og="http://schemas.neoorder.org/onegate/controls"
            x:Class="NeoOrder.OneGate.Controls.Popups.DAppFeedbackPopup"
            x:TypeArguments="x:Boolean"
            BindingContext="{Binding Source={RelativeSource Self}}">
    <VerticalStackLayout Spacing="15" MaximumWidthRequest="450">
        <Grid ColumnDefinitions="*,auto">
            <Label Text="{x:Static og:Strings.Feedback}" FontAttributes="Bold" />
            <Button Grid.Column="1" StyleClass="Icon" Text="&#xe6b5;" FontSize="24" Margin="-10" Padding="10" Clicked="OnCancel" />
        </Grid>
        <Label Text="{x:Static og:Strings.FeedbackDAppText}" />
        <Picker x:Name="pickerType" Title="{x:Static og:Strings.FeedbackType}" ItemsSource="{Binding Types}" ItemDisplayBinding="{Binding Text}" SelectedItem="{Binding SelectedType}" />
        <og:ValidationMessage Title="{x:Static og:Strings.FeedbackType}" Margin="0,-15,0,0" Target="{x:Reference pickerType}">
            <og:Required />
        </og:ValidationMessage>
        <Editor x:Name="editorMessage" Text="{Binding Message}" Placeholder="{x:Static og:Strings.FeedbackMessage}" MinimumHeightRequest="120" MaxLength="2000" />
        <og:ValidationMessage Title="{x:Static og:Strings.FeedbackMessage}" Margin="0,-15,0,0" Target="{x:Reference editorMessage}">
            <og:Required />
            <og:StringLength Max="2000" />
        </og:ValidationMessage>
        <Entry x:Name="entryEmail" Text="{Binding Email}" Placeholder="{x:Static og:Strings.FeedbackEmail}" Keyboard="Email" MaxLength="254" />
        <og:ValidationMessage Title="{x:Static og:Strings.FeedbackEmail}" Margin="0,-15,0,0" Target="{x:Reference entryEmail}">
            <og:Custom Validate="OnValidateEmail" />
        </og:ValidationMessage>
        <BoxView HeightRequest="1" Margin="-15,0" />
        <Grid ColumnDefinitions="*,auto,*" Margin="-15">
            <Button Grid.Column="0" StyleClass="Secondary" Text="{x:Static og:Strings.Cancel}" BorderWidth="0" Clicked="OnCancel" />
            <BoxView Grid.Column="1" WidthRequest="1" VerticalOptions="Fill" />
            <og:Submit Grid.Column="2" Text="{x:Static og:Strings.Feedback}" TextColor="#5676e7" ButtonColor="Transparent" Submitted="OnSubmit" />
        </Grid>
    </VerticalStackLayout>
</og:MyPopup>
