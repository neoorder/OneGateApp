<?xml version="1.0" encoding="utf-8" ?>
<og:MyPopup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:og="http://schemas.neoorder.org/onegate/controls"
            x:Class="NeoOrder.OneGate.Controls.Popups.DAppReportPopup"
            x:TypeArguments="x:Boolean"
            BindingContext="{Binding Source={RelativeSource Self}}">
    <VerticalStackLayout Spacing="15" MaximumWidthRequest="450">
        <Grid ColumnDefinitions="*,auto">
            <Label Text="{x:Static og:Strings.Report}" FontAttributes="Bold" />
            <Button Grid.Column="1" StyleClass="Icon" Text="&#xe6b5;" FontSize="24" Margin="-10" Padding="10" Clicked="OnCancel" />
        </Grid>
        <Label Text="{x:Static og:Strings.ReportDAppText}" />
        <Picker x:Name="pickerReason" Title="{x:Static og:Strings.ReportReason}" ItemsSource="{Binding Reasons}" ItemDisplayBinding="{Binding Text}" SelectedItem="{Binding SelectedReason}" />
        <og:ValidationMessage Title="{x:Static og:Strings.ReportReason}" Margin="0,-15,0,0" Target="{x:Reference pickerReason}">
            <og:Required />
        </og:ValidationMessage>
        <Entry x:Name="entryEmail" Text="{Binding Email}" Placeholder="{x:Static og:Strings.ReporterEmail}" Keyboard="Email" MaxLength="254" />
        <og:ValidationMessage Title="{x:Static og:Strings.ReporterEmail}" Margin="0,-15,0,0" Target="{x:Reference entryEmail}">
            <og:Required />
            <og:StringLength Max="254" />
            <og:Custom Validate="OnValidateEmail" />
        </og:ValidationMessage>
        <Editor x:Name="editorMessage" Text="{Binding Message}" Placeholder="{x:Static og:Strings.ReportMessage}" MinimumHeightRequest="90" MaxLength="512" />
        <og:ValidationMessage Title="{x:Static og:Strings.ReportMessage}" Margin="0,-15,0,0" Target="{x:Reference editorMessage}">
            <og:Custom Validate="OnValidateMessage" />
        </og:ValidationMessage>
        <BoxView HeightRequest="1" Margin="-15,0" />
        <Grid ColumnDefinitions="*,auto,*" Margin="-15">
            <Button Grid.Column="0" StyleClass="Secondary" Text="{x:Static og:Strings.Cancel}" BorderWidth="0" Clicked="OnCancel" />
            <BoxView Grid.Column="1" WidthRequest="1" VerticalOptions="Fill" />
            <og:Submit Grid.Column="2" Text="{x:Static og:Strings.Report}" TextColor="#5676e7" ButtonColor="Transparent" Submitted="OnSubmit" />
        </Grid>
    </VerticalStackLayout>
</og:MyPopup>
